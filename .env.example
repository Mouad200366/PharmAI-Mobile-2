DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=replace-me-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres + PostGIS (matches docker-compose service)
DATABASE_URL=postgres://pharmacy_user:pharmacy_pass@localhost:5432/pharmacy_db

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# Windows local dev only: path to OSGeo4W install (provides GDAL/GEOS DLLs for django.contrib.gis).
# Leave empty on Linux/macOS/Docker — system GDAL is auto-detected.
OSGEO4W_ROOT=

# Stripe (Phase 5). Test-mode keys from https://dashboard.stripe.com/test/apikeys
# Webhook secret from `stripe listen --forward-to localhost:8000/api/v1/payments/webhook/`
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=MAD

# Channels + Celery (Phase 6). Defaults match docker-compose.yml.
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
# Override broker URL if Redis runs elsewhere.
CELERY_BROKER_URL=
# Set to True in tests to run tasks synchronously.
CELERY_TASK_ALWAYS_EAGER=False

# Sentry (production only — leave blank in dev to disable).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.05
