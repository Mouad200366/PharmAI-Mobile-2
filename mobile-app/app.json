{
  "expo": {
    "name": "PharmAI",
    "slug": "pharmaai-mobile",
    "scheme": "pharmaai",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ma.pharmaai.mobile"
    },
    "android": {
      "package": "ma.pharmaai.mobile",
      "adaptiveIcon": {
       "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "extra": {
      "apiBaseUrl": "http://192.168.1.54:8000/api/v1",
      "wsBaseUrl": "ws://192.168.1.54:8000/ws",
      "pharmagentUrl": "http://192.168.1.54:8001",
      "eas": {
        "projectId": "17f51547-37db-462e-b613-0a4b54945765"
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PharmAI utilise votre position lorsque l'application est ouverte afin de vous proposer et gérer les livraisons à proximité."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "PharmAI utilise votre caméra uniquement pour scanner le QR code de retrait à la pharmacie.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "expo-notifications",
      "expo-font",
      "@maplibre/maplibre-react-native"
    ],
    "owner": "mouad09"
  }
}
